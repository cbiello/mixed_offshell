59e4453964d8"],

Cell["\<\
nnloC[ag] = 4*Nc*Qq^2*TR*\[Alpha]*\[Alpha]s*(FLM[z1 . Subscript[p1, q], z2 . \
Subscript[p2, OverBar[q]], p3, p4]/
    (z1*z2) + FLM[z1 . Subscript[p1, OverBar[q]], z2 . Subscript[p2, q], p3, \
p4]/
    (z1*z2))*((1 - z1)*z1 + ((1 - z1)^2 + z1^2)*Log[1 - z1] + 
   ((1 - z1)^2 + z1^2)*Log[(2*EC)/\[Mu]])*((1 - z2)*z2 + ((1 - z2)^2 + \
z2^2)*Log[1 - z2] + 
   ((1 - z2)^2 + z2^2)*Log[(2*EC)/\[Mu]]) + 
 2*Nc*Qq^2*\[Alpha]*((1 - z)*z + ((1 - z)^2 + z^2)*Log[1 - z] + 
   ((1 - z)^2 + z^2)*Log[(2*EC)/\[Mu]])*
  (ONLO[FLM[z . Subscript[p1, q], Subscript[p2, g], p3, p4, Subscript[p5, \
q]]/z] + 
   ONLO[FLM[z . Subscript[p1, OverBar[q]], Subscript[p2, g], p3, p4, 
      Subscript[p6, OverBar[q]]]/z]) + 
 Qq^2*TR*\[Alpha]*\[Alpha]s*FLM[Subscript[p1, \[Gamma]], z . Subscript[p2, \
\[Gamma]], p3, p4]*
  ((2*(103 - 12*Pi^2 + 528*z - 18*Pi^2*z - 420*z^2 - 18*Pi^2*z^2 - 211*z^3 + 
      12*Pi^2*z^3))/(27*z^2) - (4*(-1 + z)*(4 + 7*z + 4*z^2)*Log[1 - \
z]^2)/(3*z^2) + 
   ((1 + z)*Log[z]^3)/(3*z) + (4*(-20 - 57*z + 6*Pi^2*z + 39*z^2 + 6*Pi^2*z^2 \
+ 38*z^3)*
     Log[(2*EC)/\[Mu]])/(9*z^2) - (4*(-1 + z)*(4 + 7*z + 4*z^2)*Log[(2*EC)/\
\[Mu]]^2)/
    (3*z^2) + Log[z]^2*(-1/2*(5 + 11*z)/z + (4*(1 + z)*Log[(2*EC)/\[Mu]])/z) + 
   Log[z]*((2*(1 + 3*z))/z - (8*(1 + z)*Log[1 - z]^2)/z - (4*(1 + \
3*z)*Log[(2*EC)/\[Mu]])/
      z + (8*(1 + z)*Log[(2*EC)/\[Mu]]^2)/z) + 
   ((4*(1 + 3*z))/z - (16*(1 + z)*Log[(2*EC)/\[Mu]])/z)*PolyLog[2, z] + 
   Log[1 - z]*((4*(-20 - 57*z + 6*Pi^2*z + 39*z^2 + 6*Pi^2*z^2 + \
38*z^3))/(9*z^2) - 
     (8*(-1 + z)*(4 + 7*z + 4*z^2)*Log[(2*EC)/\[Mu]])/(3*z^2) - 
     (16*(1 + z)*PolyLog[2, z])/z) - (16*(1 + z)*PolyLog[3, 1 - z])/z - 
   (8*(1 + z)*PolyLog[3, z])/z + (8*(1 + z)*Zeta[3])/z) + 
 TR*\[Alpha]s*(ONLO[FLM[Subscript[p1, \[Gamma]], z . Subscript[p2, \
OverBar[q]], p3, p4, 
       Subscript[p6, OverBar[q]]]/z]*
    (2*((1 - z)*z + ((1 - z)^2 + z^2)*Log[1 - z] + ((1 - z)^2 + \
z^2)*Log[(2*EC)/\[Mu]]) + 
     ((1 - z)^2 + z^2)*Log[eta[6, 2]/2]*\[Omega]tilde[{52, 62}, {5, 2}]) + 
   ONLO[FLM[Subscript[p1, \[Gamma]], z . Subscript[p2, q], p3, p4, \
Subscript[p5, q]]/z]*
    (2*((1 - z)*z + ((1 - z)^2 + z^2)*Log[1 - z] + ((1 - z)^2 + \
z^2)*Log[(2*EC)/\[Mu]]) + 
     ((1 - z)^2 + z^2)*Log[eta[5, 2]/2]*\[Omega]tilde[{52, 62}, {6, 2}]));\
\>", "Input",
 CellChangeTimes->{{3.843474647055237*^9, 3.8434746557983923`*^9}},
 CellLabel->
  "In[269]:=",ExpressionUUID->"09c11ec9-41b6-4f34-8da8-c4d7c70ae754"]
}, Closed]],

