    ((1 - z)^2 + z^2)*Log[(2*EC)/\[Mu]]))/z + 
 (2*Qq^2*TR*\[Alpha]*\[Alpha]s*FLM[z1 . p1, z2 . p2, p3, p4]*
   ((1 - z1)*z1 + ((1 - z1)^2 + z1^2)*Log[1 - z1] + ((1 - z1)^2 + \
