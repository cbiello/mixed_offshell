      2*Log[EC]^2 - 6*Log[\[Mu]] + 6*Log[eta[2, 5]] + 4*Log[EC]*Log[eta[2, \
5]] - 
      4*Log[E5]*(Log[4*EC] + Log[eta[2, 5]]) + 4*PolyLog[2, 1 - eta[2, \
5]]))/2 + 
   Qe^2*\[Alpha]*(13 - (2*Pi^2)/3 + Log[E3/E4]^2 + 2*(3/2 - Log[E3/EC] - \
Log[E4/EC])*
      Log[eta[3, 4]] + 2*PolyLog[2, 1 - eta[3, 4]]) + 
   Qe*Qq*\[Alpha]*(2*Log[E3/EC]*Log[s23/s35] + 2*Log[E4/EC]*Log[s45/s24] - 
     2*Log[E5/EC]*Log[eta[3, 5]/eta[4, 5]] + 
