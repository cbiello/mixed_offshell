     Log[(2*EC)/\[Mu]]^2 + (3 + (-5 - 2*(-5 + z)*z)*Log[1 - z] + (1 + 2*(-1 + \
z)*z)*Log[z])*
     PolyLog[2, z] + Log[(2*EC)/\[Mu]]*(16 + (4*Pi^2*(-1 + z)^2)/3 + z*(-41 + \
30*z) + 
      (-2 - 8*(-2 + z)*z)*Log[1 - z] + (6 + 12*(-1 + z)*z)*Log[1 - z]^2 + 
      (3 + 20*(-1 + z)*z + (-4 - 8*(-1 + z)*z)*Log[1 - z])*Log[z] + (1 - \
2*z)*Log[z]^2 + 
      (-4 + 8*z)*PolyLog[2, z]) + (-9 + 2*(9 - 5*z)*z)*PolyLog[3, 1 - z] + 
    (-9 + 2*(9 - 7*z)*z)*PolyLog[3, z] + 8*(1 + 2*(-1 + z)*z)*Zeta[3] + 
