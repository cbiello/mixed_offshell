 2*TR*\[Alpha]s*((1 - z)*z + ((1 - z)^2 + z^2)*Log[1 - z] + ((1 - z)^2 + \
z^2)*Log[(2*EC)/\[Mu]])*
  ONLO[FLM[z . p1, p2, p3, p4, pa]/z] + ONLO[FLVQEDfin[p1, p2, p3, p4, pq]] + \

 Qq^2*\[Alpha]*(3/2 + 2*Log[EC/E5])*ONLO[FLM[p1, p2, p3, p4, pq]*Log[1 - \
eta[5, 1]]] - 
 Qq^2*\[Alpha]*(3/2 + 2*Log[EC/E5])*ONLO[FLM[p1, p2, p3, p4, pq]*Log[eta[5, \
1]]] + 
 TR*((1 - z)^2 + z^2)*\[Alpha]s*ONLO[(FLM[z . p1, p2, p3, p4, pa]*Log[eta[1, \
6]/2]*
     \[Omega]tilde[{\[Gamma], q}, {q, 1}])/z] + \
(4*Qe*Qq*TR*\[Alpha]*\[Alpha]s*FLM[z . p1, p2, p3, p4]*
   ((1 - z)*z + ((1 - z)^2 + z^2)*Log[1 - z] + ((1 - z)^2 + z^2)*Log[(2*EC)/\
\[Mu]])*
   (-(Log[E3/E4]*Log[z]) - Log[z*(1 - eta[1, 3])]*Log[eta[1, 3]] + 
    Log[z*(1 - eta[1, 4])]*Log[eta[1, 4]] + (3/2 + Log[EC/E3])*
     Log[eta[1, 3]/eta[2, 3]] + Log[1 - eta[2, 3]]*Log[eta[2, 3]] - 
    Log[1 - eta[2, 4]]*Log[eta[2, 4]] + (3/2 + Log[EC/E4])*Log[eta[2, \
4]/eta[1, 4]] - 
    PolyLog[2, eta[1, 3]] + PolyLog[2, eta[1, 4]] + PolyLog[2, eta[2, 3]] - 
    PolyLog[2, eta[2, 4]]))/z - (2*Qe^2*TR*\[Alpha]*\[Alpha]s*FLM[z . p1, p2, \
p3, p4]*
   ((1 - z)*z + ((1 - z)^2 + z^2)*Log[1 - z] + ((1 - z)^2 + z^2)*Log[(2*EC)/\
\[Mu]])*
   (-13 + Pi^2/3 - Log[E3/E4]^2 - 2*(3/2 - Log[E3/EC] - Log[E4/EC] - Log[1 - \
