    (1 + (35*z)/4 - 8*z^2 + (4*Pi^2*(1 + 2*(-1 + z)*z))/3 + 
      (6 + 14*(-1 + z)*z)*Log[1 - z] + (-5/2 - (-5 + z)*z)*Log[1 - \
