Cell["PLEASE READ ME: notation and conventions", "Subsection",
 CellChangeTimes->{{3.841739088602675*^9, 
  3.841739107819026*^9}},ExpressionUUID->"4e080ff7-afdd-4017-9df2-\
a830900bf25c"],

Cell[TextData[{
 "1) ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"FLM", "[", 
    RowBox[{
     RowBox[{"z", ".", "a"}], ",", "b", ",", "..."}], "]"}], ",", " ", 
   RowBox[{"FLM", "[", 
    RowBox[{"a", ",", 
     RowBox[{"z", ".", "b"}], ",", "..."}], "]"}]}]],
  CellChangeTimes->{{3.841738942962225*^9, 3.8417390057253304`*^9}},
  ExpressionUUID->"ec3cda8c-5526-4726-b8fe-1c8e6f8b432c"],
 ": do NOT contain the factor 1/z. It is explicit in the computation.\n\n2) \
",
 Cell[BoxData[
  RowBox[{"FLM", "[", 
   RowBox[{
    RowBox[{"z1", ".", "a"}], ",", 
    RowBox[{"z2", ".", "b"}], ",", "..."}], "]"}]],
  CellChangeTimes->{{3.841738942962225*^9, 3.8417390057253304`*^9}},
  ExpressionUUID->"3b6e1fae-1d56-4a71-aa7b-8d469d7120c0"],
 ": does NOT contain the factor 1/z1/z2. It is explicit in the computation.\n\
\n3) ",
 Cell[BoxData[
  RowBox[{"\[Omega]tilde", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ab", ",", "cd"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"e", ",", "f"}], "}"}]}], "]"}]],
  CellChangeTimes->{{3.841738942962225*^9, 3.8417390057253304`*^9}},
  ExpressionUUID->"e672c547-42e3-44be-b60f-3c9655d71ab2"],
 ":  limit of the partition function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Omega]", "^", 
     RowBox[{"(", 
      RowBox[{"ab", ",", " ", "cd"}], ")"}]}], 
    OverscriptBox["\[RightArrow]", 
     RowBox[{"e", " ", "//", " ", "f"}]], 
    RowBox[{"\[Omega]tilde", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ab", ",", "cd"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"e", ",", "f"}], "}"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"2779f32c-60ef-410c-bcf2-8790a0d43b81"],
 ".\n\n4) ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Alpha]s", " ", "=", " ", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["\[Alpha]", "s"], 
      RowBox[{"(", "\[Mu]", ")"}]}], "]"}]}], ",", " ", 
   RowBox[{"\[Alpha]", " ", "=", " ", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["\[Alpha]", "ew"], 
      RowBox[{"(", "\[Mu]", ")"}]}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"\[Alpha]s", "[", "\[Mu]", "]"}], " ", "=", 
    RowBox[{
     SubscriptBox["\[Alpha]", "s"], 
     RowBox[{"(", "\[Mu]", ")"}], " "}]}]}]],
  CellChangeTimes->{{3.841738942962225*^9, 3.8417390057253304`*^9}},
  ExpressionUUID->"e15b033c-379e-4954-aeb0-fe683e5f5070"],
 " \n\n5) we have performed the following simplifications: ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    RowBox[{"E1", " ", "=", " ", 
     RowBox[{"E2", " ", "=", " ", "Ec"}]}], ",", " ", 
    RowBox[{"\[Eta]12", " ", "=", " ", "1"}]}]}]],
  CellChangeTimes->{{3.841738942962225*^9, 3.8417390057253304`*^9}},
  ExpressionUUID->"cb6bcdb8-b3e9-42dc-bc2e-46b1956055e8"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.84173912776554*^9, 3.841739198381707*^9}, {
