Cell["\<\
Code LOG:\[LineSeparator]Lmu=log(mu2/mu2ref) defined in mod_hoppet_tools.f90
It is called with mu2ref=proc%mu2ref in mod_aux_sectors.f90
The scale proc%mu2ref is computed as the invariant mass of the dilepton \
(LOConfig%mu2ref = mv2) in mod_kinematics_lo.f90
Therefore the matching with our log is\
\>", "Text",
 CellChangeTimes->{{3.990267892722784*^9, 
  3.990268069976871*^9}},ExpressionUUID->"44d74eb3-c4c0-44d4-9632-\
9e5ca4453cbd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mysublog", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox["EC", "2"]}], 
        SuperscriptBox["mu", "2"]], "]"}], ":>", 
      RowBox[{"Log", "[", "fourEC2overmu2", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Log", "[", "fourEC2overmu2", "]"}], ":>", 
      RowBox[{"-", 
       RowBox[{"Log", "[", "mu2overfourEC2", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"Log", "[", "mu2overfourEC2", "]"}], ":>", 
      RowBox[{
       RowBox[{"Log", "[", "mu2overfourmll", "]"}], "+", 
       RowBox[{"Log", "[", "z", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"Log", "[", "mu2overfourmll", "]"}], ":>", "Lmu"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Log", "[", "fourEC2overmu2", "]"}], "//.", "mysublog"}]}], "Input",\

 CellChangeTimes->{{3.990499882552535*^9, 3.99049989869005*^9}},
 CellLabel->
  "In[348]:=",ExpressionUUID->"99bd2108-b796-457c-98fa-60748f9e2b85"],

