Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pqqtilde", "[", 
    RowBox[{"z_", ",", "E1_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", 
      RowBox[{"D1", "[", "z", "]"}]}], "-", 
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", "z"}], "]"}]}], "+", 
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}], "+", " ", 
     RowBox[{
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox["E1", "2"]}], 
        RowBox[{" ", 
         SuperscriptBox["mu", "2"]}]], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"D0", "[", "z", "]"}]}], "-", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}]}], ")"}]}]}], ")"}]}], ";"}]], "Input",\

 CellLabel->"In[24]:=",ExpressionUUID->"51fed073-4b5b-4325-86bb-da4ba436f10a"],

