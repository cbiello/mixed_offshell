Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DnProperties", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", "res", "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"expr", "//", "Expand"}]}], ";", "\n", "    ", 
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"res", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D0", "[", "z", "]"}], 
           RowBox[{"Log", "[", "z", "]"}]}], "->", 
          RowBox[{
           RowBox[{"Log", "[", "z", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "z"}], ")"}]}]}], "}"}]}]}], ";", "\n", "    ", 
      
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"res", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D1", "[", "z", "]"}], " ", 
           RowBox[{"Log", "[", "z", "]"}]}], "->", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"1", "-", "z"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "-", "z"}], ")"}]}], " ", 
           RowBox[{"Log", "[", "z", "]"}]}]}], "}"}]}]}], ";", "\n", "    ", 
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"res", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D1", "[", "z", "]"}], " ", 
           RowBox[{
            RowBox[{"Log", "[", "z", "]"}], "^", "2"}]}], " ", "->", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", 
