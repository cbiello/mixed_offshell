Cell[TextData[{
 StyleBox["Here we provide compact expressions for the finite reminders. When \
elastic component is involved, we assume ", "Subsection"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "1"], "=", 
    RowBox[{
     SubscriptBox["E", "2"], "=", 
     RowBox[{
      SubscriptBox["E", "3"], "=", 
      RowBox[{
       SubscriptBox["E", "4"], "=", 
       RowBox[{
        SubscriptBox["E", "max"], "=", "EC"}]}]}]}]}], TraditionalForm]], 
  "Subsection",ExpressionUUID->"1345e59c-e8d8-45ee-9e8f-58b70381fa24"], 
  "Subsection"],
 StyleBox[". \nOne CAN in principle also require ", "Subsection"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "12"], "=", 
    RowBox[{
     SubscriptBox["\[Eta]", "34"], "=", 
     RowBox[{"1", " ", "[", 
      RowBox[{"back", "-", "to", "-", 
       RowBox[{"back", " ", "kinematics"}]}], "]"}]}]}], TraditionalForm]], 
  "Subsection",ExpressionUUID->"4eb23569-a83c-4e9e-888d-a6cb373ab30c"], 
  "Subsection"],
 StyleBox[" -> no in the code, but in the tex formulae.\nAll results are \
presented in the CoM frame: Emax = E1 = E2 \[Congruent] Ec = \[Sqrt]s/2", 
  "Subsection"]
}], "Subsubsection",
