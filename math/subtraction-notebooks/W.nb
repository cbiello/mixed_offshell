Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "here", " ", "we", " ", "find", " ", "a", " ", "compact", " ", "form", " ",
      "for", " ", "the", " ", "double"}], "-", 
    RowBox[{"boosted", " ", "contribution"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"doubleboostedfinite", "=", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"finitesimpl", ",", " ", 
        RowBox[{"FLM", "[", 
         RowBox[{
          RowBox[{"q", " ", "z1"}], ",", 
          RowBox[{"qbp", " ", "z2"}], ",", "nu", ",", "l", ",", "z1", ",", 
          "z2"}], "]"}]}], "]"}], " ", 
      RowBox[{"FLM", "[", 
       RowBox[{
        RowBox[{"q", " ", "z1"}], ",", 
        RowBox[{"qbp", " ", "z2"}], ",", "nu", ",", "l", ",", "z1", ",", 
        "z2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     StyleBox["doubleboostedfiniteguess",
      FontColor->GrayLevel[0],
      Background->RGBColor[1, 1, 0]], "=", " ", 
     RowBox[{"\[Alpha]ontwopi", " ", "\[Alpha]sontwopi", " ", "CF", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["Qq", "2"], "+", 
        SuperscriptBox["Qqbp", "2"]}], ")"}], " ", 
      RowBox[{"Pqqtilde", "[", 
       RowBox[{"z1", ",", "EC"}], "]"}], " ", 
      RowBox[{"Pqqtilde", "[", 
       RowBox[{"z2", ",", "EC"}], "]"}], 
      RowBox[{"FLM", "[", 
       RowBox[{
        RowBox[{"q", " ", "z1"}], ",", 
        RowBox[{"qbp", " ", "z2"}], ",", "nu", ",", "l", ",", "z1", ",", 
        "z2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"doubleboostedfinite", "-", "doubleboostedfiniteguess"}], 
        ")"}], "//", "PowerExpand"}], "//", "Expand"}], "//", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]ontwopi", " ", ",", "\[Alpha]sontwopi", " ", ",", 
          RowBox[{"FLM", "[", 
           RowBox[{
            RowBox[{"q", " ", "z1"}], ",", 
            RowBox[{"qbp", " ", "z2"}], ",", "nu", ",", "l", ",", "z1", ",", 
            "z2"}], "]"}], ",", " ", 
          SuperscriptBox[
           RowBox[{"Log", "[", "mu", "]"}], "2"], ",", " ", 
          RowBox[{"Log", "[", "mu", "]"}], ",", "CF", ",", " ", 
          SuperscriptBox["Qq", "2"], ",", " ", 
          SuperscriptBox["Qqbp", "2"]}], " ", 
         StyleBox["}",
          FontSize->14]}], 
        StyleBox[",",
         FontSize->14], 
        StyleBox[" ",
         FontSize->14], 
        StyleBox["Simplify",
         FontSize->14]}], 
       StyleBox["]",
        FontSize->14]}], "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"%", "/.", "comframe"}], "//", "Simplify"}]}]}]], "Input",
