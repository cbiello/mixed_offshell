Cell[TextData[{
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "qq", 
      RowBox[{"IS", ",", " ", 
       RowBox[{"minus", " ", "2", "\[Epsilon]"}]}]], "(", "z", ")"}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "z"}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "\[Epsilon]"}]], 
     RowBox[{
      SubscriptBox["P", "qq"], "(", "z", ")"}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "qq", 
      RowBox[{"IS", ",", " ", 
       RowBox[{"minus", " ", "4", "\[Epsilon]"}]}]], "(", "z", ")"}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "z"}], ")"}], 
      RowBox[{
       RowBox[{"-", "4"}], "\[Epsilon]"}]], 
     RowBox[{
      SubscriptBox["P", "qq"], "(", "z", ")"}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubsuperscriptBox["P", "gg", 
       RowBox[{"NLO", ",", " ", "FS"}]], "(", "L", ")"}], "=", 
     RowBox[{
      SubsuperscriptBox["\[Gamma]", 
       RowBox[{"z", ",", 
        RowBox[{"g", "\[Rule]", " ", "gg"}]}], "22"], "+", " ", 
      RowBox[{
       FractionBox["1", "\[Epsilon]"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "2"}], "\[Epsilon]", " ", "L"}]]}], ")"}]}]}]}], 
    "\[IndentingNewLine]", " "}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "qg", 
      RowBox[{"NLO", ",", " ", "IS"}]], "(", "z", ")"}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "z"}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "\[Epsilon]"}]], 
