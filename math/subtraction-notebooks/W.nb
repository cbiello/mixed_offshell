Cell[TextData[{
 StyleBox["Here we provide compact expressions for the finite reminders. When \
", "Subsection"],
 StyleBox["elastic component", "Subsection",
  FontColor->RGBColor[1, 0, 0],
  Background->RGBColor[1, 1, 0]],
 StyleBox[" ", "Subsection",
  Background->RGBColor[1, 1, 0]],
 StyleBox["is involved, we assume ", "Subsection"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "1"], "=", 
    RowBox[{
     SubscriptBox["E", "2"], "=", 
     RowBox[{
      SubscriptBox["E", "3"], "=", 
      RowBox[{
       SubscriptBox["E", "4"], "=", 
       RowBox[{
        SubscriptBox["E", "max"], "=", "EC"}]}]}]}]}], TraditionalForm]], 
  "Subsection",ExpressionUUID->"09624483-445f-4fba-8ec8-a3cdf0db5923"], 
  "Subsection"],
 StyleBox[". \nOne CAN in principle also require ", "Subsection"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "12"], "=", 
    RowBox[{
     SubscriptBox["\[Eta]", "34"], "=", 
     RowBox[{"1", " ", "[", 
      RowBox[{"back", "-", "to", "-", 
       RowBox[{"back", " ", "kinematics"}]}], "]"}]}]}], TraditionalForm]], 
  "Subsection",ExpressionUUID->"c0a96c5a-c554-46f6-87f6-a52d064149fb"], 
  "Subsection"],
 StyleBox[" -> no in the code, but in the tex formulae.\nAll results are \
presented in the CoM frame: Emax = E1 = E2 \[Congruent] Ec = \[Sqrt]s/2", 
  "Subsection"]
}], "Subsubsection",
 CellChangeTimes->{{3.9329749546665783`*^9, 3.93297507233539*^9}, {
  3.979387686800886*^9, 3.9793877002314587`*^9}, {3.979396435327338*^9, 
