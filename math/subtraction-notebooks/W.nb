Cell[CellGroupData[{

Cell[TextData[{
 "NNLO mixed QEDxQCD off-shell W: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", 
    OverscriptBox["q", "_"]}], TraditionalForm]],ExpressionUUID->
  "1d5ef447-3c35-41ec-bbea-7eaf1d640c5b"],
 " channel"
}], "Title",
 CellChangeTimes->{{3.825385688183281*^9, 3.825385699337428*^9}, {
  3.830590372588901*^9, 3.83059037600749*^9}, {3.839646573290213*^9, 
  3.839646593615304*^9}, {3.921763848146522*^9, 3.921763850514261*^9}, {
  3.967108858317841*^9, 3.967108859061706*^9}, {3.9900656896005163`*^9, 
  3.9900656907209587`*^9}},ExpressionUUID->"f74757a6-af49-4cce-a68d-\
c107986b3fe3"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"The", " ", "notebook", " ", "starts", " ", "here"}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.989982597881909*^9, 3.989982605418541*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"cf97d0b6-c628-499f-ac70-6098de0e65c7"],

Cell["\<\
We consider the process: q(1,Qq)+qp(2,Qqp) -> l(3,Ql)+lb(4,Qlp)+g(5)+a(6)
The conservation is Qq+Qqp=Ql+Qlp
The Catani charges are T(1)=-Qq, T(2)=-Qqp, T(3)=Ql, T(4)=Qlp, with \\sum_i \
T(i) =0\
\>", "Text",
 CellChangeTimes->{{3.98998265390949*^9, 3.9899827705468397`*^9}, {
  3.990093779193012*^9, 
  3.9900937793691177`*^9}},ExpressionUUID->"c70b59ef-c534-4eea-9ef5-\
c77735439386"],

Cell["\<\
Applications:
Z case: \t(Qq,Qqp,Ql,Qlp)=(Qup,-Qup,Ql,-Ql) with Ql=electron charge=-1
W+ case: \t(Qq,Qqp,Ql,Qlp)=(Qup,-Qdn,0d0,-Ql) with Ql=electron charge=-1
W- case:\t(Qq,Qqp,Ql,Qlp)=(Qdn,-Qup,Ql,0d0) with Ql=electron charge=-1\
\>", "Text",
 CellChangeTimes->{{3.989982798111272*^9, 3.989982901337531*^9}, {
  3.989982953345943*^9, 
  3.989982973039321*^9}},ExpressionUUID->"1b1a1c1e-9cfb-4869-8f92-\
de5f4ff54135"],

Cell["\<\
Therefore the Catani operator is (sum_{ij} T(i).T(j) ...) or equivalently \
(-Qq)(-Qqp)... + (-Qq)Ql ... + (-Qqp) Ql ... + (-Qq)Qlp ... + (-Qqp) Qlp ... \
+ Ql Qlp ...\
\>", "Text",
 CellChangeTimes->{{3.989982984942626*^9, 
  3.989983086342572*^9}},ExpressionUUID->"c4d3d8a8-73c2-4a6b-9c97-\
156bd6e749ee"],

Cell[TextData[{
 "The old notebook had Qq+Qqp+Ql+Qlp=0, therefore it was T(1)=Qp, T(2)=Qqp, \
therefore Qqp_old=-Qqp && Qq_old=-Qq\nThen, focusing only on W+, Qe_old=Qlp \
therefore\nI_catani=  (Qq_old)(Qqp_old)... + 0d0 ... + 0d0 ... + \
(Qq_old)Qe_old ... + (Qqp_old) Qe_old ... + 0d0 ...\nCharge_conservation = \
{-Qq_old-Qqp_old == 0d0+Qe_old} = {Qe_old + Qq_old + Qqp_old == 0}\n",
 StyleBox["TODO: apply the replacement rules derived here for the entire \
following notebook to get a proper W+ integrated CT set",
  Background->RGBColor[1, 0.75, 0, 0.33]],
 "\n",
 StyleBox["TODO: apply the right modifications to map W+ to W-, as follows:",
  Background->RGBColor[0.8, 0.3, 0.8, 0.33]],
 "\n3 <-> 4 (sij, FLM, eta, E, L)\nQlp <-> Ql\nCharge_conservation= W+{Qq+Qqp \
== 0d0+Qlp} --> W-{Qq+Qqp == 0d0+Ql}"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9899831591455727`*^9, 3.989983396729271*^9}, {
  3.9899834321243887`*^9, 3.989983597644268*^9}, {3.9899838278644953`*^9, 
  3.989983853156431*^9}},ExpressionUUID->"f7206b3c-73ab-4088-967b-\
73fdfa3aefce"],

