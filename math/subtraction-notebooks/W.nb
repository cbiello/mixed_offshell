        StyleBox[" ",
         FontSize->14], 
        StyleBox["Factor",
         FontSize->14]}], 
       StyleBox["]",
        FontSize->14]}], "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"%", "/.", "comframe"}]}]}]], "Input",
