Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqqNlo", "[", 
    RowBox[{"z_", ",", "L_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"D0", "[", "z", "]"}]}], "-", 
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}], "-", 
    RowBox[{"2", " ", "L", " ", 
     RowBox[{"delta", "[", 
      RowBox[{"1", "-", "z"}], "]"}]}], "+", 
    RowBox[{"\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["L", "2"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"4", " ", 
        RowBox[{"D1", "[", "z", "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{"D2", "[", "z", "]"}]}], "-", 
       RowBox[{
        FractionBox["4", "3"], 
        SuperscriptBox["L", "3"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "3"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["2", "3"], 
        SuperscriptBox["L", "4"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{
        FractionBox["8", "3"], 
        RowBox[{"D3", "[", "z", "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}], "+", 
       RowBox[{
        FractionBox["4", "3"], 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "3"]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "4"], "ErrorPqqNLO"}]}]}], ";"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"b6c0bdc7-4dd3-4f7d-8c42-687281088455"],

Cell[BoxData[
