Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "here", " ", "we", " ", "find", " ", "a", " ", "compact", " ", "form", " ",
     "for", " ", "the", " ", "boosted", " ", "virtual", " ", "QCD", " ", 
    "fin", " ", "contribution"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"boostedQCDfin", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"finitesimplNEW", ",", " ", 
         RowBox[{"FLVqcdfin", "[", 
          RowBox[{"q", ",", 
           RowBox[{"qp", " ", "z"}], ",", "l", ",", "lp", ",", "z"}], "]"}]}],
         "]"}], " ", 
       RowBox[{"FLVqcdfin", "[", 
        RowBox[{"q", ",", 
         RowBox[{"qp", " ", "z"}], ",", "l", ",", "lp", ",", "z"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"finitesimplNEW", ",", " ", 
         RowBox[{"FLVqcdfin", "[", 
          RowBox[{
           RowBox[{"z", " ", "q"}], ",", "qp", ",", "l", ",", "lp", ",", 
           "z"}], "]"}]}], "]"}], " ", 
       RowBox[{"FLVqcdfin", "[", 
        RowBox[{
         RowBox[{"z", " ", "q"}], ",", "qp", ",", "l", ",", "lp", ",", "z"}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"boostedQCDfinguess", "=", " ", 
     RowBox[{"\[Alpha]ontwopi", " ", "\[Alpha]sontwopi", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["Qqp", "2"], " ", 
         RowBox[{"Pqqtilde", "[", 
          RowBox[{"z", ",", "EC"}], "]"}], " ", 
         RowBox[{"FLVqcdfin", "[", 
          RowBox[{"q", ",", 
           RowBox[{"qp", " ", "z"}], ",", "l", ",", "lp", ",", "z"}], "]"}]}],
         "+", 
        RowBox[{
         SuperscriptBox["Qq", "2"], " ", 
         RowBox[{"Pqqtilde", "[", 
          RowBox[{"z", ",", "EC"}], "]"}], " ", 
         RowBox[{"FLVqcdfin", "[", 
          RowBox[{
           RowBox[{"z", " ", "q"}], ",", "qp", ",", "l", ",", "lp", ",", 
           "z"}], "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"boostedQCDfin", "-", "boostedQCDfinguess"}], ")"}], "//", 
       "PowerExpand"}], "//", "Expand"}], "//", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
