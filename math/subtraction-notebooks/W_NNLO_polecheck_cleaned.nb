  3.841808018962796*^9}},ExpressionUUID->"07a9ac4c-a245-4022-b64c-\
73cea52103aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqqAP1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["2", 
        RowBox[{"1", "+", "z"}]], "-", "1", "+", "z"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", "z"}]}], "]"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        SuperscriptBox[
         RowBox[{"Log", "[", "z", "]"}], "2"]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"Log", "[", "z", "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", "z"}], "]"}]}], "-", 
       FractionBox[
        SuperscriptBox["\[Pi]", "2"], "6"]}], ")"}]}], "+", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], 
     RowBox[{"Log", "[", "z", "]"}]}], "+", 
    RowBox[{"4", 
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.841729042058612*^9, 3.841729043198976*^9}, {
   3.84172908536901*^9, 3.841729122762074*^9}, {3.841808022393942*^9, 
