    RowBox[{"\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["L", "2"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
