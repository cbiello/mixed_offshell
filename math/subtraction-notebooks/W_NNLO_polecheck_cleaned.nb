Cell["2) One-loop Altarelli-Parisi splitting function -> PDF REN", "Text",
 CellChangeTimes->{{3.840682301775136*^9, 3.840682303321611*^9}, {
  3.840682345837638*^9, 3.840682364351165*^9}, {3.841729053868642*^9, 
