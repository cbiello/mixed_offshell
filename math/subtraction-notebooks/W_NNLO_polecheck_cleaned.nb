Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqqNLOfsr", "[", "L_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"2", " ", "L"}], "+", 
    FractionBox["3", "2"], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        SuperscriptBox["L", "2"]}], "+", 
       FractionBox[
        RowBox[{"2", 
         SuperscriptBox["\[Pi]", "2"]}], "3"], "-", 
       FractionBox["13", "2"]}], ")"}], "\[Epsilon]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"4", 
         SuperscriptBox["L", "3"]}], "3"], "-", 
       RowBox[{"16", " ", 
        RowBox[{"Zeta", "[", "3", "]"}]}], "-", 
       SuperscriptBox["\[Pi]", "2"], "+", "26"}], ")"}], 
     SuperscriptBox["\[Epsilon]", "2"]}], "+", 
    RowBox[{
     FractionBox["1", "15"], " ", 
     RowBox[{"(", 
      RowBox[{"1560", "-", 
       RowBox[{"10", " ", 
        SuperscriptBox["L", "4"]}], "-", 
       RowBox[{"65", " ", 
        SuperscriptBox["\[Pi]", "2"]}], "-", 
       RowBox[{"6", " ", 
        SuperscriptBox["\[Pi]", "4"]}], "-", 
       RowBox[{"360", " ", 
        RowBox[{"Zeta", "[", "3", "]"}]}]}], ")"}], " ", 
     SuperscriptBox["\[Epsilon]", "3"]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "4"], "ErrorPqqNLOfsr"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"f61ce2de-52cd-4d30-b306-c3f42c6995f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqqNlo", "[", 
    RowBox[{"z_", ",", "L_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"D0", "[", "z", "]"}]}], "-", 
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}], "-", 
    RowBox[{"2", " ", "L", " ", 
     RowBox[{"delta", "[", 
      RowBox[{"1", "-", "z"}], "]"}]}], "+", 
    RowBox[{"\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["L", "2"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"4", " ", 
        RowBox[{"D1", "[", "z", "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{"D2", "[", "z", "]"}]}], "-", 
       RowBox[{
        FractionBox["4", "3"], 
        SuperscriptBox["L", "3"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "3"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["2", "3"], 
        SuperscriptBox["L", "4"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{
        FractionBox["8", "3"], 
        RowBox[{"D3", "[", "z", "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}], "+", 
       RowBox[{
        FractionBox["4", "3"], 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "3"]}]}], ")"}]}], "+", 
    RowBox[{
