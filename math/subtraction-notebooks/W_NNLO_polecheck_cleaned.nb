Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"process", ":", " ", 
     RowBox[{
      RowBox[{"\[Gamma]", 
       RowBox[{"(", "1", ")"}]}], "+", " ", 
      RowBox[{"g", 
       RowBox[{"(", "2", ")"}]}]}]}], " ", "->", " ", 
    RowBox[{
     RowBox[{"nu", 
      RowBox[{"(", "3", ")"}]}], "+", 
     RowBox[{"l", 
      RowBox[{"(", "4", ")"}]}], "+", 
     RowBox[{
      OverscriptBox["q", "_"], 
      RowBox[{"(", "5", ")"}]}], "+", 
     RowBox[{
      OverscriptBox[
       RowBox[{"q", "'"}], "_"], 
      RowBox[{"(", "6", ")"}]}]}]}], "\n", 
   RowBox[{"\[Alpha]sB", "=", " ", 
    FormBox[
     RowBox[{"[", 
      SubscriptBox["\[Alpha]", "b"]}],
     TraditionalForm]}]}], "]"}]], "Text",
