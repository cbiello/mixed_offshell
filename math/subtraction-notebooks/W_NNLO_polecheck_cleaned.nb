  3.840682342438212*^9}},ExpressionUUID->"4fdde986-3561-4a4c-a429-\
63c301317e5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TCg\[Gamma]", "[", 
   RowBox[{"z_", ",", "E1_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"2", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"TR", "*", "CF", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "/", "ep"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "5"}], "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", "z"}], ")"}]}], ")"}], "/", 
                "2"}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{"3", "*", "z"}]}], ")"}], "*", 
                  RowBox[{"Log", "[", "z", "]"}]}], ")"}], "/", "2"}], "+", 
               RowBox[{
