Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqgAP0timesPqqfin", "[", 
    RowBox[{"z_", ",", "E1_"}], "]"}], ":=", "  ", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "\[Epsilon]"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
