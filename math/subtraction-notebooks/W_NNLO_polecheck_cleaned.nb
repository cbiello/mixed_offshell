Cell["1) Triple collinear splitting", "Text",
 CellChangeTimes->{{3.840682301775136*^9, 
  3.840682342438212*^9}},ExpressionUUID->"70d5a174-5ecf-46fb-b4c2-\
9d0d13df0108"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TCqqbq", "[", 
    RowBox[{"z_", ",", "E1_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"CA", "-", 
         RowBox[{"2", " ", "CF"}]}], ")"}], " ", "CF", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "ep"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Pi", "^", "2"}], "*", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"z", "^", "2"}]}], ")"}]}], "+", 
               RowBox[{"3", "*", 
                RowBox[{"(", 
                 RowBox[{"8", "-", 
                  RowBox[{"15", "*", "z"}], "+", 
                  RowBox[{"7", "*", 
                   RowBox[{"z", "^", "2"}]}]}], ")"}]}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"12", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "z"}], ")"}]}], ")"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "5"}], "+", 
                 RowBox[{"2", "*", 
                  RowBox[{"z", "^", "2"}]}]}], ")"}], "*", 
               RowBox[{"Log", "[", "z", "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"4", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "z"}], ")"}]}], ")"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"z", "^", "2"}]}], ")"}], "*", 
               RowBox[{"Log", "[", 
                RowBox[{"1", "-", "z"}], "]"}], "*", 
               RowBox[{"Log", "[", "z", "]"}]}], ")"}], "/", 
