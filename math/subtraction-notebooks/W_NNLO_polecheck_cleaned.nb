          RowBox[{"2", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", "z"}], "+", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "3"]}], "-", 
       RowBox[{
        FractionBox["2", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", "z"}], "+", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", "z", "]"}], "3"]}], "-", 
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"9", 
             SuperscriptBox["z", "2"]}], "-", 
            RowBox[{"13", "z"}], "+", "4"}], ")"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", 
              SuperscriptBox["z", "2"]}], "-", 
             RowBox[{"6", "z"}], "+", "3"}], ")"}], 
           RowBox[{"Log", "[", "z", "]"}]}]}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            FractionBox["4", "3"]}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"4", 
                 SuperscriptBox["\[Pi]", "2"]}], "-", "51"}], ")"}], 
              SuperscriptBox["z", "2"]}], "+", 
             RowBox[{"60", "z"}], "-", "9"}], ")"}]}], "-", 
          RowBox[{"4", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", 
              SuperscriptBox["z", "2"]}], "-", 
