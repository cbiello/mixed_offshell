            RowBox[{"(", 
             RowBox[{"12", "*", 
              RowBox[{"(", 
               RowBox[{"1", "+", "z"}], ")"}]}], ")"}]}]}], ")"}]}], ")"}], "*",
        "REG"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"CA", "-", 
         RowBox[{"2", " ", "CF"}]}], ")"}], " ", "CF", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "ep"}], "*", 
          RowBox[{"(", "0", ")"}]}], "+", 
         RowBox[{"(", "0", ")"}]}], ")"}], "*", "PLUS"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"CA", "-", 
         RowBox[{"2", " ", "CF"}]}], ")"}], " ", "CF", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"1", "/", "ep"}], "*", 
          RowBox[{"(", "0", ")"}]}], "+", 
         RowBox[{"(", "0", ")"}]}], ")"}], "*", "DELTA"}]}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"CA", "\[Rule]", "0"}], ",", " ", 
      RowBox[{"CF", "\[Rule]", "1"}], ",", 
      RowBox[{"TR", "\[Rule]", "1"}], ",", " ", 
