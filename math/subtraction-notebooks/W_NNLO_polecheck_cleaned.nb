Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pq\[Gamma]fin", "[", 
    RowBox[{"z_", ",", "E1_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "\[Epsilon]"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"Gamma", "[", 
          RowBox[{"1", "-", "\[Epsilon]"}], "]"}], "2"], 
        RowBox[{"Gamma", "[", 
         RowBox[{"1", "-", 
          RowBox[{"2", "\[Epsilon]"}]}], "]"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "E1"}], ")"}], 
        RowBox[{
         RowBox[{"-", "2"}], "\[Epsilon]"}]], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "z"}], ")"}], 
          RowBox[{
           RowBox[{"-", "2"}], "\[Epsilon]"}]], 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"1", "+", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", "z"}], ")"}], "2"]}], "z"], "-", 
           RowBox[{"\[Epsilon]", " ", "z"}]}], ")"}]}], ")"}]}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"Gamma", "[", 
         RowBox[{"1", "-", "\[Epsilon]"}], "]"}], 
        RowBox[{
         SuperscriptBox["\[Mu]", 
          RowBox[{"2", "\[Epsilon]"}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[Epsilon]", " ", "EulerGamma"}]]}]], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", "z"}], ")"}], "2"]}], "z"], ")"}]}]}], 
     ")"}]}]}], ";"}]], "Input",
