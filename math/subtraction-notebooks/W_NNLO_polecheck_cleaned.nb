        RowBox[{"D1", "[", "z", "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{"1", "-", "z"}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{"D2", "[", "z", "]"}]}], "-", 
       RowBox[{
        FractionBox["4", "3"], 
        SuperscriptBox["L", "3"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", "z"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "3"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["2", "3"], 
        SuperscriptBox["L", "4"], 
        RowBox[{"delta", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{
        FractionBox["8", "3"], 
        RowBox[{"D3", "[", "z", "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
