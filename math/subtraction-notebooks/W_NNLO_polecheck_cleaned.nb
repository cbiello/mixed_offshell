Cell[TextData[{
 "0) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "q\[Gamma]", "fin"], "(", 
     RowBox[{"z", ",", "E"}], ")"}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "\[Epsilon]"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox["\[CapitalGamma]", "2"], "(", 
          RowBox[{"1", "-", "\[Epsilon]"}], ")"}], 
         RowBox[{"\[CapitalGamma]", "(", 
          RowBox[{"1", "-", 
           RowBox[{"2", "\[Epsilon]"}]}], ")"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "E"}], ")"}], 
         RowBox[{
          RowBox[{"-", "2"}], "\[Epsilon]"}]], 
        RowBox[{
         SubsuperscriptBox["P", "q\[Gamma]", "NLO"], "(", "z", ")"}]}], "-", 
       RowBox[{
        FractionBox[
         RowBox[{"\[CapitalGamma]", "(", 
          RowBox[{"1", "-", "\[Epsilon]"}], ")"}], 
         RowBox[{
          SuperscriptBox["\[Mu]", 
           RowBox[{"2", "\[Epsilon]"}]], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[Epsilon]", " ", 
            SubscriptBox["\[Gamma]", "E"]}]]}]], 
        RowBox[{
         SubsuperscriptBox["P", "q\[Gamma]", 
          RowBox[{"AP", ",", "0"}]], "(", "z", ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"54c164fe-f764-4623-a08d-024bac118469"]
}], "Text",
