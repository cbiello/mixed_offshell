             RowBox[{"2", "z"}], "+", "1"}], ")"}], 
           RowBox[{"Log", "[", "z", "]"}]}]}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"6", "z"}], "-", 
          RowBox[{"4", 
           SuperscriptBox["z", "2"]}]}], ")"}], 
        RowBox[{"Log", "[", "z", "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"16", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "z"}], "-", "1"}], ")"}], 
        RowBox[{"PolyLog", "[", 
         RowBox[{"3", ",", 
          RowBox[{"1", "-", "z"}]}], "]"}]}], "+", 
       RowBox[{"8", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "z"}], "-", "1"}], ")"}], 
        RowBox[{"PolyLog", "[", 
