          RowBox[{"PqgAP0z", "[", "z", "]"}]}], "+", 
         RowBox[{"PqgNLOCV", "[", "z", "]"}]}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[Epsilon]"}], " ", "EulerGamma"}]], 
       SuperscriptBox["\[Mu]", 
