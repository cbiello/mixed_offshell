Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqgNLOCV", "[", "z_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "3"}], 
     SuperscriptBox["z", "2"]}], "+", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        SuperscriptBox["z", "2"]}], "-", 
       RowBox[{"2", "z"}], "+", "1"}], ")"}], 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", "z"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "4"}], 
        SuperscriptBox["z", "2"]}], "+", 
       RowBox[{"2", "z"}], "-", "1"}], ")"}], 
     RowBox[{"Log", "[", "z", "]"}]}], "+", 
    RowBox[{"5", "z"}], "-", "2", "+", 
    RowBox[{"\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "z"}]}], ")"}], 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", "z"}], "]"}]}], "+", 
       RowBox[{
        FractionBox["1", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Pi]", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "z"}], "-", "1"}], ")"}]}], "-", 
          RowBox[{"3", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"8", 
              SuperscriptBox["z", "2"]}], "-", 
             RowBox[{"9", "z"}], "+", "1"}], ")"}]}]}], ")"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", "z"}], "+", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", "z"}], "+", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", "z", "]"}], "2"]}], "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"5", "z"}], "+", "2"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "z"}], "+", "3"}], ")"}], 
        RowBox[{"Log", "[", "z", "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Epsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "z"}], "-", "1"}], ")"}], 
        RowBox[{"PolyLog", "[", 
         RowBox[{"3", ",", 
          RowBox[{"1", "-", "z"}]}], "]"}]}], "+", 
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "z"}], "-", "1"}], ")"}], 
        RowBox[{"PolyLog", "[", 
         RowBox[{"3", ",", "z"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", "z"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "z"}], "+", "3"}], ")"}]}], "+", 
          RowBox[{"4", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "z"}], "-", "1"}], ")"}], 
           RowBox[{"Log", "[", 
            RowBox[{"1", "-", "z"}], "]"}]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "12"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"4", 
              SuperscriptBox["z", "2"]}], "+", 
             RowBox[{"z", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", 
                 RowBox[{"Zeta", "[", "3", "]"}]}], "-", "5"}], ")"}]}], "-", 
             
             RowBox[{"Zeta", "[", "3", "]"}], "+", "1"}], ")"}]}], "-", 
          RowBox[{
           SuperscriptBox["\[Pi]", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "z"}], "+", "3"}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["4", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", "z"}], "+", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "3"]}], "-", 
       RowBox[{
        FractionBox["2", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", "z"}], "+", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", "z", "]"}], "3"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "z"}], "-", "1"}], ")"}], 
           RowBox[{"Log", "[", "z", "]"}]}], "-", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", 
              SuperscriptBox["z", "2"]}], "-", 
             RowBox[{"5", "z"}], "+", "2"}], ")"}]}]}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "z"}], "]"}], "2"]}], "+", 
       RowBox[{
        FractionBox["2", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"24", 
           SuperscriptBox["z", "2"]}], "-", 
          RowBox[{"2", 
           SuperscriptBox["\[Pi]", "2"], "z"}], "-", 
          RowBox[{"27", "z"}], "+", 
          SuperscriptBox["\[Pi]", "2"], "+", "3"}], ")"}], 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "z"}], "+", "3"}], ")"}], 
        SuperscriptBox[
         RowBox[{"Log", "[", "z", "]"}], "2"]}], "+", 
       RowBox[{
        FractionBox["2", "3"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Pi]", "2"], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", "z"}]}], ")"}]}], "-", "3"}], ")"}], 
        RowBox[{"Log", "[", "z", "]"}]}]}], ")"}]}]}]}], ";"}]], "Input",
