Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PqqNlo", "[", 
    RowBox[{"z_", ",", "L_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"D0", "[", "z", "]"}]}], "-", 
