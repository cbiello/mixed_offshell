Cell[TextData[{
 "The channel is a genuine interference between QCD and QED diagrams. \n \
Example in MG: generate u d~ > ve e+ d d~ where q=u and \
q\[CloseCurlyQuote]=",
 Cell[BoxData[
  FormBox[
   OverscriptBox["d", "_"], TraditionalForm]],ExpressionUUID->
  "b2c6dc76-8aa4-46ec-81f6-5167ce858e4d"],
 ", we choose q\[CloseCurlyQuote]\[CloseCurlyQuote]=d~ but you can put any \
kind of quark in principle."
}], "Text",
