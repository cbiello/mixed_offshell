3104a85de957"],

Cell["\<\
subprocess 1 :  \[Gamma](1) -> qb(5) + \[LineSeparator]                       \
                   q(1z) g (2) -> nu (3) + l (4)  + qb\[CloseCurlyQuote](6)
subprocess 2 : \[Gamma](1) -> qb\[CloseCurlyQuote](6) +
                                            q\[CloseCurlyQuote](1z) g (2) -> \
nu (3) + l(4) + qb(5)
subprocess 3 : \[Gamma](1) -> l(4) +
                                            lb(1z) g (2) -> nu (3) + qb(5) + \
qb\[CloseCurlyQuote](6)
                                            Finite
subprocess 4 :  g(2) -> qb(5) + \[LineSeparator]                              \
            \[Gamma](1) q (z.2) -> nu (3) + l (4)  + qb\[CloseCurlyQuote](6)
subprocess 5 : g(2) -> qb\[CloseCurlyQuote](6) +
                                          \[Gamma](1) \
q\[CloseCurlyQuote](z.2) -> nu (3) + l(4) + qb(5)\
\>", "Text",
 CellChangeTimes->{
  3.9452454408910713`*^9, {3.945245535022139*^9, 3.945245638058909*^9}, {
   3.966075751789444*^9, 3.966075755901279*^9}, {3.966075892067272*^9, 
   3.9660760154278917`*^9}, {3.966611405357319*^9, 3.9666116412266207`*^9}, {
