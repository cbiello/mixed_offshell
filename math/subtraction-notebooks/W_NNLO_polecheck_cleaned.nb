            RowBox[{"Log", "[", "z", "]"}], "2"]}], "-", 
          RowBox[{"8", "z", 
           RowBox[{"(", 
            RowBox[{"1", "-", "z"}], ")"}], 
           RowBox[{"Log", "[", "z", "]"}]}]}], ")"}], 
