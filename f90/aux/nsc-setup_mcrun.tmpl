#!/bin/bash

echo ""

## terminate if error, e.g. executable not found
set -e

if [[ -z $LOGFILE ]]; then
  exec 2> /dev/null 3>&1
else
  exec 3> >(while read TEXT ; do echo $TEXT ; echo $(date +"%d.%m.%Y %H:%M:%S") $TEXT >> $LOGFILE; done)
  exec 2>> $LOGFILE
fi

# set -e

printhelp() {
cat << EOF
Usage: ./nsc-setup_mcrun [OPTION]... [VAR=VALUE]...

To assign a variable (e.g., sec, setup...), specify them as
VAR=VALUE. See below for descriptions of some of the useful variables.

Default [def] and optional [opt] values are specified in brackets.

  --sec=SECTSF       reads from file SECTSF containing the list of sectors to be run
                     [def: $PWD/lo_sectors_list.dat]
  --setup=SETFILE    reads from file SETFILE containing the parameters for the setup
                     [def: $PWD/nsc-setup.dat]
  --out=OUTFILE      writes output to file OUTFILE
                     [def: $PWD/nsc-run]
  --log=LOGFILE      writes log to LOGFILE
                     [def: $PWD/nsc-run.log]
  --mcpath=PATH      selects PATH as the path of the MC binary, e.g. $HOME/local/bin
                     [def: $PWD]
  --sbatch=SBRUN     produces a sbatch file to be submitted using the slurm system
                     [def: false] [opt:true/false]

Report bugs to <federico.buccioni@physics.ox.ac.uk>.

EOF
exit
}

findprog() {
    #echo -n "looking for $1... " 1>&3
    var="$2"
    set -- ${!var:+"${!var}"} "${@:3}"
    for prog in "$@" ; do
        echo "Checking option $prog in path" 1>&2
        full="`type -P "$prog"`" && {
            #echo "$full" 1>&3
            printf -v "CONF_$var" "%q" "$full"
            return 0
        }
    done
    # echo "no $@ in your path" 1>&3
    return 1
}

SECTSFILE=$PWD/lo_sectors_list.dat
SETUPFILE=$PWD/nsc-setup.dat
OUTFILE=$PWD/nsc-run
LOGFILE=$PWD/nsc-run.log
MCPATH=$PWD
inputfile=input.dat
SBATCHFLAG=false

for arg in "$@" ; do
    case "$arg" in
        --sec=*)
            SECTSFILE="${arg#--sec=}" ;;
        --setup=*)
            SETUPFILE="${arg#--setup=}" ;;
        --out=*)
            OUTFILE="${arg#--out=}" ;;
        --log=*)
            LOGFILE="${arg#--log=}" ;;
        --mcpath=*)
            MCPATH="${arg#--mcpath=}" ;;
        --sbatch=*)
            SBATCHFLAG="${arg#--sbatch=}" ;;
        --help )
            printhelp ;;
        -*)
            echo "Warning: $arg is not a valid option." 1>&3
            printhelp ;;
        *=*)
            eval "$arg" ;;
        *)
            echo "Warning: $arg is not a valid argument." 1>&3
            printhelp ;;
    esac
done

if [ -f "$SECTSFILE" ] 
then
    echo "Reading sectors to run from input file...... ${SECTSFILE}"
else
    echo "File ${SECTSFILE} does not exist. Aborting" && exit 1
fi

if [ -f "$SETUPFILE" ] 
then
    echo "Reading from input file..................... ${SETUPFILE}"
else
    echo "File ${SETUPFILE} does not exist. Aborting" && exit 1
fi

### Cleanup
if test -f $OUTFILE; then
    rm -rf $OUTFILE
fi

if test -f "$LOGFILE"; then
    rm $LOGFILE
fi

source $SETUPFILE

#look for hsummer bin
PATH=$PATH:$MCPATH findprog $exec MCP $exec || (echo "Did not find mixed_ll executable. Specify the path of mixed_ll using the --mcpath option, e.g. --mcpath=$HOME/local/bin" && exit 1)

### Generate command
if [[ $withMPI == "true" ]]; then
    if [[ $SBATCHFLAG == "false" ]]; then
        cmmd="mpirun -np $ncores $MCPATH/$exec"
    else
        cmmd="srun $MCPATH/$exec"
    fi
else
    cmmd="$MCPATH/$exec"
fi

if [ -d "$histodir" ] 
then
    echo "Directory ${histodir} already exists." > /dev/null
else
    mkdir $histodir
fi

if [[ $saveoutput == "true" ]]; then
    echo "Saving the output"
    if [ -d "$outdir" ] 
    then
	echo "Output directory ${outdir} already exists." > /dev/null
    else
	echo "Creating output directory"
	mkdir $outdir
    fi
else
    echo "Do not save the output"
fi
   

### Create submission script
awk -v prefix="$cmmd" '{print prefix $0}' $SECTSFILE > $OUTFILE
sed -i 's/[ \t]*$//' $OUTFILE
sed -i -e "s/$/ \-f $inputfile -histodir $histodir/" $OUTFILE

### Adjust parameters for runs with virtual EWK loops
if [ -z ${vgsNc0+x} ] || [ -z ${vgsNc1+x} ] || [ -z ${vgsIt0+x} ] || [ -z ${vgsIt1+x} ];
then
    echo "Vegas parameters not specified -> use code default"
else
    echo "Vegas parameters specified -> overwrite the configuration file, and rescale for the virtuals"
 
    sed -i -e "s/$/ \-vegasNc0 vgsNc0 -vegasNc1 vgsNc1 -vegasIt0 vgsIt0 -vegasIt1 vgsIt1/" $OUTFILE
    
    VvgsNc0=$[$vgsNc0/10]
    VVvgsNc0=$[$vgsNc0/200]
    VvgsNc1=$[$vgsNc1/10]
    VVvgsNc1=$[$vgsNc1/200]

    ### Replace vegas parameters for vewk
    sed -i -e "/vewk/ s/vgsNc0/$VvgsNc0/" $OUTFILE
    sed -i -e "/vewk/ s/vgsNc1/$VvgsNc1/" $OUTFILE
    sed -i -e "/vvfc/ s/vgsNc0/$VvgsNc0/" $OUTFILE
    sed -i -e "/vvfc/ s/vgsNc1/$VvgsNc1/" $OUTFILE
    
    ### Replace vegas parameters for vewk
    sed -i -e "/vvxf/ s/vgsNc0/$VVvgsNc0/" $OUTFILE
    sed -i -e "/vvxf/ s/vgsNc1/$VVvgsNc1/" $OUTFILE
    
    ### Standard Vegas
    sed -i -e "s/vgsNc0/$vgsNc0/g" $OUTFILE
    sed -i -e "s/vgsNc1/$vgsNc1/g" $OUTFILE
    sed -i -e "s/vgsIt0/$vgsIt0/g" $OUTFILE
    sed -i -e "s/vgsIt1/$vgsIt1/g" $OUTFILE
fi

### Prepare to save output
if [[ $saveoutput == "true" ]]; then
    sed -i -e "s/$/ > outname/" $OUTFILE
fi

### Info for logfile
cp $SECTSFILE $PWD/tmp_sects.txt
sed -i -e "s/\-//g" $PWD/tmp_sects.txt
sed -i -e "s/corr *lo//g" $PWD/tmp_sects.txt
sed -i 's/[ \t]*$//' $PWD/tmp_sects.txt
ct=0
while IFS= read -r line; do
    ct=$[$ct+1]
    textout="echo \"DATETAG. Starting: $line\" >> LOGFILE \&\& "
    sed -i "${ct}s/^/$textout/" $OUTFILE

    if [[ $saveoutput == "true" ]]; then
	outname=`echo $SETUPFILE $line".log" | sed 's/ /_/g'`
	sed -i -e "0,/outname/{s/outname/$outdir\/$outname/}" $OUTFILE
    fi

done < $PWD/tmp_sects.txt
rm $PWD/tmp_sects.txt

sed -i -e "s/DATETAG/\$(date)/g" $OUTFILE
sed -i -e 's?LOGFILE?'$LOGFILE'?' $OUTFILE

if [[ $SBATCHFLAG == "true" ]]; then
    echo "#!/bin/sh
#SBATCH -p mypartition
#SBATCH -n $ncores
#SBATCH --mem-per-cpu=1G

module load mpich

" > $PWD/tmpsbatchfile.tmp
    cat $OUTFILE >> $PWD/tmpsbatchfile.tmp
    mv $PWD/tmpsbatchfile.tmp $OUTFILE

    echo ""
    echo "Please first specify the partition in $OUTFILE, then you can now lunch your runs. Simply type: "
    echo "sbatch $OUTFILE"
    echo ""
else
    sed -i -e '1 i\#!\/bin\/bash\n' $OUTFILE
    chmod +x $OUTFILE
    echo ""
    echo "You can now lunch your runs. Simply type: "
    echo "bash $OUTFILE"
    echo ""
fi
