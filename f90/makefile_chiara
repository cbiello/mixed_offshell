clean:
	echo 'Removing *~ files'
	for i in $(VPATH); do rm -f $$i/*~; done
	rm -f *~

remove: clean
	echo 'Removing executable, objects, modules and dependencies'
	rm -f $(EXEC)
	rm -f $(OBJSDIR)/*
	rm -f $(MODDIR)/*
	rm -f $(TWOLOOPDIR)/*.o
	rm -f $(TWOLOOPDIR)/*.a
	rm -f $(TWOLOOPDIR)/*.log
	rm -f makedep.inc

wipe: clean remove
	echo 'Removing histogram and grid files'
	rm -f $(HISTODIR)/*
	rm -f $(GRIDDIR)/*.grid
	rm -f $(BINDIR)/*
	rm -f config.log
	rm -f config.cfg
	rm -f makefile.inc
	rm -f Analysis/mod_cut_histo.f90
