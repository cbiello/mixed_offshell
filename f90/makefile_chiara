LIBS=
ifeq ($(WithLHAPDF),Yes) 
 LIBS +=-L$(LHAPDF) -lLHAPDF
endif

ifeq ($(WithHoppet),Yes) 
 LIBS +=-L$(HOPPETLIB) -lhoppet_v1
 LIBS +=-I$(HOPPETINC)
endif

ifeq ($(WithChaplin),Yes) 
 LIBS +=-L$(CHAPLIN) -lchaplin
endif

ifeq ($(WithGiNaC),Yes)
 LIBS +=-L$(GINAC)/lib -lcln
 LIBS +=-L$(CLN)/lib -lginac
endif

ifeq ($(WithHandyG),Yes) 
 LIBS +=-L$(HANDYG)/lib -lhandyg
 LIBS +=-I$(HANDYG)/include
endif

ifeq ($(WithQCDLoop),Yes) 
 LIBS +=-L $(QCDLOOP) -lff -lqcdloop
endif

ifeq ($(WithCollier),Yes) 
 LIBS +=-L $(COLLIER) -lcollier
 LIBS +=-I $(COLLIER)/modules
endif

ifeq ($(WithOpenLoops),Yes)
 ifeq ($(myOS),Linux)
  LIBS += "-Wl,-rpath=$(OPENLOOPS)/lib"
 endif
 LIBS +=-L$(OPENLOOPS)/lib -lopenloops
 LIBS +=-I$(OPENLOOPS)/lib_src/openloops/mod
endif

ifeq ($(-D_with2L),1)
LIBS += -lstdc++ -lm
endif

