#####################################################################

$(EXEC): $(MAIN) $(TWOLINSTDIR) $(TWOLINSTOBJ) $(OBJS) $(HISTODIR) $(GRIDDIR) $(BINDIR)
	$(F95) $(FOPTS) $(patsubst %,$(OBJSDIR)/%,$(OBJS)) $(LIBS) $(MAIN) -o $(EXEC)

$(OBJSDIR):
	mkdir -p $(OBJSDIR)

$(MODDIR):
	mkdir -p $(MODDIR)

$(HISTODIR):
	mkdir -p $(HISTODIR)

$(GRIDDIR):
	mkdir -p $(GRIDDIR)

$(BINDIR):
	mkdir -p $(BINDIR)
	gfortran -o bin/nsc-hsummer aux/nsc-hsummer.f90
	cp aux/nsc-combine_histos.tmpl bin/nsc-combine_histos && chmod +x bin/nsc-combine_histos
	cp aux/nsc-setup_mcrun.tmpl bin/nsc-setup_mcrun && chmod +x bin/nsc-setup_mcrun

$(TWOLINSTDIR):
ifeq ($(-D_with2L),1)
	$(info Downloading and compiling two-loop amplitudes)
	@rm -f src/TwoLoop/*.o
	@wget https://users.ox.ac.uk/~phys2058/projects/mix_qcdewk_ll/twoloopamp_x183L4a08DgW6j2/twoloop_mixqcdewk_ll.tar.gz
	@mv twoloop_mixqcdewk_ll.tar.gz src/TwoLoop && cd src/TwoLoop && rm -rf twoloop_mixqcdewk_ll && tar xf twoloop_mixqcdewk_ll.tar.gz && cd ../..
	@rm -f src/TwoLoop/*.tar.gz
else
	touch $(Here)/src/TwoLoop/tmptwoloopdir.log
endif

$(TWOLINSTOBJ):
ifeq ($(-D_with2L),1)
	$(info Compiling two-loop amplitudes)
	@cd src/TwoLoop/twoloop_mixqcdewk_ll/ && make && cp *.o ../ && cp *.a ../ && cp -r auto_generated ../../../ && cd ../../../
else
	touch $(Here)/src/TwoLoop/tmptwoloopobj.log
endif

#`-' -> don't complain if it's not there
-include makedep.inc

makedep.inc:
	$(PYCMD) get_dep.py


#%.o %.mod --> create both in single pass
%.o %.mod: %.f90 | $(OBJSDIR) $(MODDIR)
	$(F95) $(FOPTS) $(LIBS) $(SETFFOUT) $(OBJSDIR)/$@ $<

%.o: %.F | $(OBJSDIR) $(MODDIR)
	$(F95) $(FOPTS) $(LIBS) $(SETFFOUT) $(OBJSDIR)/$@ $<

#####################################################################

ifeq ($(-D_with2L),1)
objects/handyG_cpp.o: src/TwoLoop/handyG_cpp.o
	@cp src/TwoLoop/handyG_cpp.o objects/handyG_cpp.o

objects/handyG_fortran.o: src/TwoLoop/handyG_fortran.o
	@cp src/TwoLoop/handyG_fortran.o objects/handyG_fortran.o

objects/vv_nonfact.a: src/TwoLoop/vv_nonfact.a
	@cp src/TwoLoop/vv_nonfact.a objects/vv_nonfact.a
endif

