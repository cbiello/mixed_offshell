
#####################################################################

EXEC = mixed_ll
ConfigFile = config.cfg

TWOLOOPDIR=src/TwoLoop
OBJSDIR = objects
MODDIR = modules
HISTODIR = histo
GRIDDIR = grid
BINDIR = bin

myOS := $(shell uname -s)

VPATH = src $(OBJSDIR) src/BasicDef src/Parms src/Parser src/AuxFunctions src/HoppetTools src/Amplitudes $(TWOLOOPDIR) src/Kinematics src/SingLimits src/IntSub src/Sectors \
